		font-size: 64px;
		color: #dfe6ef;
		margin-left: 8px;
		margin-right: 8px;
	}

	.star.on {
		color: #f5c451;
	}

	.main {
		font-size: 24px;
		color: #1f2d3d;
		text-align: center;
		margin-top: 20px;
	}

	.sub {
		font-size: 17px;
		color: #d9822b;
		text-align: center;
		margin-top: 8px;
	}

	.wrong {
		margin-top: 24px;
	}

	.wrong-t {
		font-size: 17px;
		color: #8a9bb0;
		margin-bottom: 8px;
	}

	.row {
		flex-direction: row;
		align-items: center;
		background-color: #ffffff;
		border-radius: 14px;
		padding: 14px;
		margin-bottom: 8px;
	}

	.row-q {
		font-size: 14px;
		color: #a8b4c4;
		width: 66px;
	}

	.row-t {
		flex: 1;
		font-size: 17px;
		color: #24313f;
	}

	.row-play {
		font-size: 15px;
		color: #2f7fd8;
		padding: 6px 10px;
	}

	.footer {
		flex: 1;
		justify-content: flex-end;
	}

	.btn {
		height: 80px;
		border-radius: 22px;
		background-color: #7fb2ef;
		align-items: center;
		justify-content: center;
		margin-bottom: 12px;
	}

	.btn-t {
		font-size: 26px;
		color: #ffffff;
	}

	.btn2 {
		height: 68px;
		border-radius: 20px;
		background-color: #ffffff;
		border-width: 1px;
		border-style: solid;
		border-color: #e3e9f2;
		align-items: center;
		justify-content: center;
	}

	.btn2-t {
		font-size: 22px;
		color: #24313f;
	}

	.home {
		align-items: center;
		padding: 16px;
	}

	.home-t {
		font-size: 16px;
		color: #8a9bb0;
	}
</style>
