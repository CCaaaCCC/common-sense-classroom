<template>
	<view class="page">
		<view class="head">
			<text class="back" @click="back">返回</text>
			<text class="title">选一个场景</text>
			<view class="ph">
				<view class="dot" :class="{ on: state.deviceOnline }"></view>
			</view>
		</view>

		<view class="scenes">
			<view
				v-for="s in scenes"
				:key="s.id"
				class="scene"
				:class="{ on: selected == s.id }"
				@click="pick(s.id)"
			>
				<image class="cover" :src="s.cover" mode="aspectFill"></image>
				<text class="scene-name">{{ s.name }}</text>
			</view>
		</view>

		<text class="label">题量</text>
		<view class="counts">
			<view class="pill" :class="{ on: count == 2 }" @click="count = 2">
				<text class="pill-t">2 题</text>
			</view>
			<view class="pill" :class="{ on: count == 4 }" @click="count = 4">
				<text class="pill-t">4 题</text>
			</view>
			<view class="pill" :class="{ on: count == 8 }" @click="count = 8">
				<text class="pill-t">8 题</text>
			</view>
		</view>

		<view class="row" @click="toggleText">
			<text class="row-t">显示文字</text>
			<view class="sw" :class="{ on: state.showText }">
				<view class="sw-dot" :class="{ on: state.showText }"></view>
			</view>
		</view>

		<view class="row" @click="toggleVoice">
			<text class="row-t">播放语音</text>
			<view class="sw" :class="{ on: state.autoVoice }">
				<view class="sw-dot" :class="{ on: state.autoVoice }"></view>
			</view>
		</view>

		<view class="footer">
			<view class="go" :class="{ off: selected == '' }" @click="go">
				<text class="go-t">开始</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
	import { ref } from 'vue'
	import { Scene } from '../../data/types.uts'
	import { SCENES, sceneOf } from '../../data/scenes.uts'
	import { state, startSession } from '../../store/index.uts'
	import { saveSettings } from '../../utils/storage.uts'

	const scenes: Scene[] = SCENES
	const selected = ref('class')
	const count = ref(4)

	onMounted(() => {
		if (state.cfgSceneId != '') selected.value = state.cfgSceneId
		if (state.cfgCount > 0) count.value = state.cfgCount
	})

	function pick(id: string) {
		selected.value = id
	}

	function toggleText() {
		state.showText = !state.showText
		saveSettings()
	}

	function toggleVoice() {
		state.autoVoice = !state.autoVoice
		saveSettings()
	}

	function back() {
		uni.navigateBack()
	}

	function go() {
		if (selected.value == '') return
		const s = sceneOf(selected.value)
		startSession(s.id, count.value)
		uni.navigateTo({ url: '/pages/session/session' })
	}
</script>

<style>
	.page {
		flex: 1;
		background-color: #f6f8fb;
		padding: 20px 18px;
	}

	.head {
		flex-direction: row;
		align-items: center;
		height: 48px;
	}

	.back {
		font-size: 16px;
		color: #2f7fd8;
		width: 60px;
	}

	.title {
		flex: 1;
		text-align: center;
		font-size: 22px;
		color: #1f2d3d;
	}

	.ph {
		width: 60px;
		align-items: flex-end;
	}

	.dot {
		width: 8px;
		height: 8px;
		border-radius: 4px;
		background-color: #c9d8ea;
	}

	.dot.on {
		background-color: #4cc38a;
	}

	.scenes {
		flex-direction: row;
		margin-top: 16px;
	}

	.scene {
		flex: 1;
		border-radius: 18px;
		background-color: #ffffff;
		border-width: 3px;
		border-style: solid;
		border-color: #ffffff;
		padding: 10px;
		margin-right: 12px;
		align-items: center;
	}

	.scene.on {
		border-color: #7fb2ef;
	}

	.cover {
		width: 100%;
		height: 120px;
		border-radius: 12px;
		background-color: #e9eef5;
	}

	.scene-name {
		font-size: 20px;
		color: #24313f;
		margin-top: 8px;
	}

	.label {
		font-size: 17px;
		color: #8a9bb0;
		margin-top: 24px;
	}

	.counts {
		flex-direction: row;
		margin-top: 10px;
	}

	.pill {
		width: 96px;
		height: 44px;
		border-radius: 22px;
		background-color: #ffffff;
		border-width: 1px;
		border-style: solid;
		border-color: #e3e9f2;
		align-items: center;
		justify-content: center;
		margin-right: 12px;
	}

	.pill.on {
		background-color: #e8f3ff;
		border-color: #7fb2ef;
	}

	.pill-t {
		font-size: 18px;
		color: #24313f;
	}

	.row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		background-color: #ffffff;
		border-radius: 16px;
		padding: 16px;
		margin-top: 12px;
	}

	.row-t {
		font-size: 19px;
		color: #24313f;
	}

	.sw {
		width: 52px;
		height: 30px;
		border-radius: 15px;
		background-color: #dfe6ef;
		padding: 3px;
	}

	.sw.on {
		background-color: #7fb2ef;
	}

	.sw-dot {
		width: 24px;
		height: 24px;
		border-radius: 12px;
		background-color: #ffffff;
	}

	.sw-dot.on {
		margin-left: 22px;
	}

	.footer {
		flex: 1;
		justify-content: flex-end;
		padding-bottom: 16px;
	}

	.go {
		height: 80px;
		border-radius: 22px;
		background-color: #7fb2ef;
		align-items: center;
		justify-content: center;
	}

	.go.off {
		background-color: #c9d8ea;
	}

	.go-t {
		font-size: 26px;
		color: #ffffff;
	}
</style>
