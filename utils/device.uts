import { state } from '../store/index.uts'

// 与 ESP32（或 PC 模拟器）的 WebSocket 长连接。
// uni-app x 没有 offMessage，重复注册会叠加监听，所以整个 App 只维护一个 SocketTask。
//
// gen 是「连接代次」：doConnect / disconnect 都会自增，所有 socket 回调先校验代次。
// 没有它会出现两个经典问题：
//   1) connect() 在已连接时被再次调用 → 旧 socket 的 onClose 触发重连 → 关掉刚连上的
//      socket → 又触发重连，形成 1 秒一次的自我维持循环；
//   2) 旧 socket 的 onError/onClose 迟到一个心跳周期，把新连接标记成离线。
let socket: SocketTask | null = null
let connected = false
let manualClose = false
let retry = 0
let retryTimer = 0
let hbTimer = 0
let lastRx = 0
let gen = 0

let handler: ((m: UTSJSONObject) => void) | null = null
let openHandler: (() => void) | null = null

export function onDeviceMessage(cb: (m: UTSJSONObject) => void) {
	handler = cb
}

export function clearDeviceMessage() {
	handler = null
}

// 重连成功后的回调：session 用它重置 seq 并重新下发当前题
export function onDeviceOpen(cb: () => void) {
	openHandler = cb
}

export function clearDeviceOpen() {
	openHandler = null
}

export function isOnline(): boolean {
	return connected
}

// 允许填 "192.168.4.1"（真实板子，端口 81）或 "192.168.1.109:8081"（PC 模拟器）
function buildUrl(addr: string): string {
	// 中文输入法常把半角冒号打成全角，这里统一
	const clean = addr.trim().replace('：', ':')
	let host = clean
	let port = '81'
	const i = host.indexOf(':')
	if (i > 0) {
		port = host.substring(i + 1).trim()
		host = host.substring(0, i).trim()
	}
	return 'ws://' + host + ':' + port + '/'
}

export function connect(addr: string) {
	const ip = addr.trim()
	if (ip == '') return
	manualClose = false
	// 已经连着同一个地址就什么都不做：关掉再连会触发旧 socket 的 onClose 重连
	if (connected && ip == state.deviceIp) return
	state.deviceIp = ip
	retry = 0
	doConnect(ip)
}

export function disconnect() {
	manualClose = true
	gen = gen + 1
	if (retryTimer != 0) {
		clearTimeout(retryTimer)
		retryTimer = 0
	}
	stopHeartbeat()
	closeSocket()
	connected = false
	state.deviceOnline = false
}

function closeSocket() {
	if (socket != null) {
		const s = socket
		socket = null
		s.close({})
	}
}

function scheduleRetry(ip: string) {
	if (retryTimer != 0) return
	retry = retry + 1
	let delay = 1000
	if (retry == 2) delay = 2000
	if (retry >= 3) delay = 4000
	if (retry >= 5) delay = 8000
	retryTimer = setTimeout(() => {
		retryTimer = 0
		if (!manualClose) doConnect(ip)
	}, delay)
}

function doConnect(ip: string) {
	gen = gen + 1
	const g = gen
	// 换地址/重连前先清掉待触发的重试，否则旧地址的定时器会把新连接顶掉
	if (retryTimer != 0) {
		clearTimeout(retryTimer)
		retryTimer = 0
	}
	stopHeartbeat()
	closeSocket()

	const url = buildUrl(ip)
	console.log('[DEV] connect ' + url)
	const s = uni.connectSocket({ url: url })

	socket = s
	s.onOpen(() => {
		if (g != gen) return
		console.log('[DEV] open')
		connected = true
		retry = 0
		lastRx = Date.now()
		state.deviceOnline = true
		startHeartbeat(g)
	})

	s.onMessage((res) => {
		if (g != gen) return
		lastRx = Date.now()
		const raw = res.data as string
		if (raw == null) return
		let msg: UTSJSONObject | null = null
		try {
			msg = JSON.parse(raw) as UTSJSONObject
		} catch (e) {
			console.log('[DEV] bad json')
			return
		}
		if (msg == null) return
		const t = msg.getString('t')
		if (t == 'hello') {
			// 先回 welcome，再让业务层补发 task，保证设备侧顺序正确
			sendWelcome(state.sessionId)
			if (openHandler != null) openHandler()
			return
		}
		if (t == 'pong') return
		if (handler != null) handler(msg)
	})

	s.onClose((res) => {
		if (g != gen) return
		console.log('[DEV] close code=' + res.code.toString())
		connected = false
		state.deviceOnline = false
		stopHeartbeat()
		if (!manualClose) scheduleRetry(ip)
	})

	s.onError(() => {
		if (g != gen) return
		console.log('[DEV] error')
		connected = false
		state.deviceOnline = false
		stopHeartbeat()
		closeSocket()
		if (!manualClose) scheduleRetry(ip)
	})
}

function startHeartbeat(g: number) {
	stopHeartbeat()
	hbTimer = setInterval(() => {
		// 代次变了说明这条心跳属于旧连接，直接停掉，别去碰新 socket
		if (g != gen) {
			stopHeartbeat()
			return
		}
		if (Date.now() - lastRx > 20000) {
			// 20s 没有任何帧，判定断线，主动重连
			closeSocket()
			connected = false
			state.deviceOnline = false
			if (!manualClose) scheduleRetry(state.deviceIp)
			return
		}
		sendPing()
	}, 5000)
}

function stopHeartbeat() {
	if (hbTimer != 0) {
		clearInterval(hbTimer)
		hbTimer = 0
	}
}

function send(obj: UTSJSONObject) {
	if (!connected || socket == null) return
	socket.send({ data: JSON.stringify(obj) })
}

export function sendWelcome(sid: string) {
	send({ t: 'welcome', sid: sid } as UTSJSONObject)
}

export function sendTask(sid: string, scene: string, qid: string, idx: number, total: number) {
	send({
		t: 'task',
		sid: sid,
		scene: scene,
		qid: qid,
		idx: idx,
		total: total
	} as UTSJSONObject)
}

export function sendDisarm(sid: string) {
	send({ t: 'disarm', sid: sid } as UTSJSONObject)
}

export function sendReward(sid: string, qid: string, ok: boolean, hint: number) {
	send({ t: 'reward', sid: sid, qid: qid, ok: ok, hint: hint } as UTSJSONObject)
}

export function sendIdle() {
	send({ t: 'idle' } as UTSJSONObject)
}

function sendPing() {
	send({ t: 'ping', ts: Date.now() } as UTSJSONObject)
}
