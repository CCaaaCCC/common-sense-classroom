import { state } from '../store/index.uts'

const ctx = uni.createInnerAudioContext()
let token = 0
// started 只在真正调用 ctx.play() 之前置 true：
// ctx.stop() 之后、新音频开播之前到达的旧 onEnded/onError 会被 finish() 挡掉，
// 不会误触发下一段音频的回调（这条竞态用 token 是防不住的）
let started = false
let handler: ((ok: boolean) => void) | null = null

function finish(ok: boolean) {
	if (!started) return
	started = false
	const h = handler
	handler = null
	if (h != null) h(ok)
}

ctx.onEnded(() => {
	finish(true)
})

ctx.onError(() => {
	finish(false)
})

export function play(src: string, done: (ok: boolean) => void) {
	token = token + 1
	const my = token
	started = false
	handler = done
	ctx.stop()
	ctx.volume = state.volume
	ctx.playbackRate = 0.8
	ctx.src = src
	setTimeout(() => {
		if (my != token) return
		started = true
		ctx.play()
	}, 30)
}

export function stop() {
	token = token + 1
	started = false
	handler = null
	ctx.stop()
}
